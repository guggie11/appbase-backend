APP_NAME=Appbase
DEBUG=true
DATABASE_URL=postgresql+psycopg://appbase:appbase@localhost:5432/appbase
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=changeme-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
FRONTEND_URL=http://localhost:5173
ALGORITHM=HS256

# OAuth / SSO (C2) — hanya isi provider yang digunakan
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Microsoft OAuth (opsional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/microsoft/callback
MICROSOFT_TENANT_ID=common

# TGSSO (Telkom SSO - OIDC standard)
TGSSO_CLIENT_ID=
TGSSO_CLIENT_SECRET=
TGSSO_AUTH_URL=
TGSSO_TOKEN_URL=
TGSSO_USERINFO_URL=
TGSSO_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/tgsso/callback

# Frontend redirect setelah OAuth
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/oauth/callback
OAUTH_ERROR_REDIRECT=http://localhost:5173/oauth/error
