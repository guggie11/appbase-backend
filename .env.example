APP_NAME=Appbase
DEBUG=true

# Hostnames below are Docker Compose service names. Running the backend
# directly on your machine instead? Replace db/redis with localhost.
DATABASE_URL=postgresql+psycopg://appbase:appbase@db:5432/appbase
REDIS_URL=redis://redis:6379/0

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Local mail catcher shipped with the compose stack.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@appbase.local
