# Generic
__pycache__/
*.py[cod]
*$py.class
*.so
.DS_Store

# Env
.env
.env.*
!.env.example

# uv / venv
.venv/
.uv/

# Distribution
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp

# Pyright / ruff cache
.ruff_cache/
.pyright/
pyrightconfig.json

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Alembic
# Migrations MUST be committed: they are the schema's source of truth, and a
# fresh clone cannot build its database without them. Only the local scratch
# file Alembic writes during autogenerate is ignored.
alembic/versions/*.tmp

# OpenAPI export
openapi.json

# Logs
*.log
test.db
